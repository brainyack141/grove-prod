# Backend runtime configuration — copy to `Backend/.env.local` (gitignored) for local dev,
# and set the same values as secrets on the deployment host (e.g. `fly secrets set ...`).

# --- Supabase (project: Grove) ---

# Postgres connection string. Get it from the Supabase dashboard:
#   Project → Connect → Transaction pooler (port 6543, IPv4-friendly, best for containers)
# It looks like:
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# <DB-PASSWORD> is the database password, not an API key. If you never saved it, reset it
# under Project → Database → Database password.
SUPABASE_DB_URL=

# Project REST origin + secret key. Only needed once media moves to Supabase Storage;
# the relational layer talks straight to Postgres via SUPABASE_DB_URL above.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# --- Existing backend configuration (see Backend/DEPLOY.md) ---

# Google Gemini key (plant scans, Ari text/photo answers, and bounded safety review).
# Local macOS dev falls back to the Keychain, so this can stay empty here.
# Optional GEMINI_MODEL overrides the default (gemini-3.7-flash).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
# Ari uses the same model by default. These overrides let its
# answer latency and reasoning be tuned independently from scan jobs.
# GEMINI_BOTANIST_MODEL=gemini-3.7-flash
# GEMINI_BOTANIST_MAX_ATTEMPTS=2
# GEMINI_BOTANIST_THINKING_LEVEL=medium
# GEMINI_BOTANIST_THINKING_BUDGET=0
# GEMINI_BOTANIST_MAX_OUTPUT_TOKENS=4096

# Botanist v2 rollout. Set BOTANIST_V2_ENABLED=true only for an internal/staging
# environment or a full launch, false for an emergency stop, or leave it unset
# and raise the stable per-account rollout percentage from 0 to 100.
# BOTANIST_V2_ENABLED=false
BOTANIST_V2_ROLLOUT_PERCENT=0

# Contract-v6 photo conversations. Set true for full photo-native answers,
# false for the Gemini scan-summary-to-Gemini-text rollback path, or leave
# unset and raise the stable account cohort percentage.
# BOTANIST_VISION_ENABLED=false
BOTANIST_VISION_ROLLOUT_PERCENT=0

# HTTPS origin clients use, e.g. https://<your-app>.fly.dev
PUBLIC_BASE_URL=

# Shared app secret. When set, every /v1 request must send X-Grove-App-Key with this value.
GROVE_APP_KEY=
