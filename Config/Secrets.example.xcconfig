// Copy to Config/Secrets.xcconfig (gitignored) and fill in. Never commit the copy.
//
// GROVE_APP_KEY must match the GROVE_APP_KEY secret on the gateway
// (Supabase Edge Functions / Backend). It is sent as `X-Grove-App-Key` and
// lands in the app's Info.plist as `GroveAppKey`. Leave empty and the app logs
// an error and sends no gateway requests; Release builds refuse to build.

GROVE_APP_KEY =

// Production gateway origins (Info.plist `GroveAnalysisURL` / `GroveSyncURL`).
// Without one, the services behind it are disabled with a logged config error;
// Release builds refuse to build. Both must be https and end in `/`.
//
// xcconfig treats `//` as the start of a comment, so write `https:/$()/` for
// the scheme. For a Supabase project:
//
//   GROVE_ANALYSIS_URL = https:/$()/<project-ref>.supabase.co/functions/v1/
//   GROVE_SYNC_URL = https:/$()/<project-ref>.supabase.co/functions/v1/api/v1/

GROVE_ANALYSIS_URL =
GROVE_SYNC_URL =

// Optional: sign with a different Apple developer team than the default in
// Config/Grove.xcconfig.
// DEVELOPMENT_TEAM = ABCDE12345
