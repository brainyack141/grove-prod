# Production build configuration — copy to `.env.production` (gitignored) and fill in.
# Values are baked into the app at build time by scripts/prod-phone.sh and
# scripts/archive-appstore.sh.

# Public HTTPS origin of the Supabase Edge Functions gateway that hosts plant
# analysis and species search, with the trailing /functions/v1/ path, e.g.
# https://<project-ref>.supabase.co/functions/v1/
GROVE_ANALYSIS_BASE_URL=

# HTTPS data-sync API (with trailing /v1/), e.g.
# https://<project-ref>.supabase.co/functions/v1/api/v1/
# Required for Release builds and the production gateway check.
GROVE_API_BASE_URL=

# The release scripts pass these two to xcodebuild as GROVE_ANALYSIS_URL and
# GROVE_SYNC_URL. For Xcode / Debug builds put them in Config/Secrets.xcconfig.

# Must match the GROVE_APP_KEY secret set on the gateway
# (e.g. `supabase secrets set GROVE_APP_KEY=...`).
# For Xcode / Debug builds put the same value in Config/Secrets.xcconfig
# (gitignored; copy Config/Secrets.example.xcconfig).
GROVE_APP_KEY=

# --- Subscriptions (RevenueCat) ---------------------------------------------
# The PUBLIC Apple SDK key from RevenueCat → Project settings → API keys.
# It begins with `appl_` and is meant to ship inside the binary: it can only
# read offerings and purchase on behalf of the signed-in Apple account.
#
# Never put a secret key (`sk_…`) here. Secret keys can issue refunds and read
# every customer record; the Release build refuses to compile if it sees one.
#
# Leave empty in Debug to run Grove in its pre-catalogue state, where nothing is
# metered because nothing can be sold. Release builds fail without it, so a
# build that cannot sell a subscription can never reach TestFlight.
REVENUECAT_API_KEY=

# --- Single Sign-On (Sign in with Apple / Google) ---------------------------
# See SSO_SETUP.md for the one-time console steps that produce these values.
# Debug builds with these values empty offer only the explicit "This iPhone
# only" path. Provider buttons never fall back to a differently keyed local
# account. Release builds fail at build time if these values are missing.

# Supabase Auth endpoint (project URL, no trailing path) and the project's
# publishable anon key. Baked into the app so it can exchange Apple/Google
# identity tokens for a real Supabase session.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Google iOS OAuth client id and its reversed form (the URL scheme). From the
# GoogleService-Info.plist / Google Cloud Console iOS OAuth client.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_REVERSED_CLIENT_ID=

# --- Supabase-side provider config (read by supabase/config.toml) -----------
# These are consumed by `supabase config push` / the local stack, NOT baked
# into the app. Set them in your shell / CI before running Supabase commands.

# Audience the Supabase project checks identity tokens against.
# Apple: the app bundle id, e.g. nz.co.thinkingai.Grove
# Google: the Google *iOS* OAuth client id (optionally plus the Web client id, comma-separated)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=nz.co.thinkingai.Grove
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# OAuth provider secrets — only needed for the web redirect flow, not the
# native id_token grant the iOS app uses. Safe to leave empty for iOS-only.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- On-device scripts (scripts/prod-phone.sh, dev-phone.sh, visual-tour.sh) -
# The iPhone to build for and install on. Can also be exported in your shell.
# GROVE_DEVICE_ID: the device UDID (`xcrun xctrace list devices`), passed to
#   `xcodebuild -destination id=…`. Required; the scripts stop if it is unset.
# GROVE_DEVICECTL_ID: optional CoreDevice identifier for `xcrun devicectl`
#   (`xcrun devicectl list devices`). Defaults to GROVE_DEVICE_ID.
GROVE_DEVICE_ID=
GROVE_DEVICECTL_ID=
