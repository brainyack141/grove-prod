<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same as ExportOptions.plist but uploads straight to App Store
         Connect / TestFlight instead of exporting a local .ipa. Used by
         .github/workflows/testflight.yml. -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>upload</string>
    <key>teamID</key>
    <string>Q5688GHWHJ</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>uploadSymbols</key>
    <true/>
    <!-- Build number is set from the CI run number at archive time; don't
         let xcodebuild rewrite it from App Store Connect state. -->
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
